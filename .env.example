# 复制为 .env 后，修改并刷新浏览器即可生效。
# 同名系统环境变量优先于 .env；修改系统环境变量后需要重启服务器。
APP_NAME="澜序"
APP_NAME_EN="Lansway"
APP_ICON="/assets/lansway.svg"
APP_THEME="gemini"
APP_COLOR_MODE="dark"

# 自定义图标请放到 assets/ 内，再将 APP_ICON 改为对应 /assets/... 路径。
# APP_THEME 控制默认主题，APP_COLOR_MODE 支持 light / dark / system。
# .env 仅向页面公开以上五个外观字段，不要把密钥写入这些字段。
# PORT 可通过系统环境变量设置，默认 5173。
